{
  "openapi": "3.0.0",
  "info": {
    "title": "GlobeTrotter Destinations Service",
    "version": "1.0.0",
    "description": "Search travel destinations (seed + tourist curated + REST Countries)."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/destinations": {
      "get": {
        "summary": "Search destinations",
        "parameters": [
          { "name": "q", "in": "query", "schema": { "type": "string" } },
          { "name": "tag", "in": "query", "schema": { "type": "string" } },
          { "name": "continent", "in": "query", "schema": { "type": "string" } },
          { "name": "max_cost", "in": "query", "schema": { "type": "integer" } },
          { "name": "source", "in": "query", "schema": { "type": "string", "enum": ["all", "local"] } }
        ],
        "responses": {
          "200": { "description": "List of destinations" }
        }
      }
    }
  }
}
