{
  "openapi": "3.0.0",
  "info": {
    "title": "GlobeTrotter Itineraries Service",
    "version": "1.0.0",
    "description": "Create and list travel itineraries."
  },
  "paths": {
    "/health": {
      "get": {
        "summary": "Health check",
        "responses": { "200": { "description": "OK" } }
      }
    },
    "/itineraries": {
      "get": {
        "summary": "List itineraries for current user",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "200": { "description": "List of itineraries" },
          "401": { "description": "Unauthorized" }
        }
      },
      "post": {
        "summary": "Create itinerary",
        "security": [{ "bearerAuth": [] }],
        "responses": {
          "201": { "description": "Created" },
          "400": { "description": "Bad request" },
          "401": { "description": "Unauthorized" }
        }
      }
    }
  },
  "components": {
    "securitySchemes": {
      "bearerAuth": {
        "type": "http",
        "scheme": "bearer",
        "bearerFormat": "JWT"
      }
    }
  }
}
